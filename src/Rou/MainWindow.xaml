<Window x:Class="Rou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Rou.Models"
        xmlns:local="clr-namespace:Rou"
        Title="Rou" Width="376" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <local:BoolToVis x:Key="Vis" />
        <local:TextToVis x:Key="TextVis" />

        <!-- 分组标题 -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Grid Margin="8,10,8,2">
                <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Fg2}" />
                <TextBlock Text="{Binding ItemCount}" FontSize="9.5" Foreground="{DynamicResource Brush.Fg3}"
                           HorizontalAlignment="Right" Margin="0,1,0,0" />
            </Grid>
        </DataTemplate>

        <!-- 任务行 -->
        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type m:TaskRow}">
            <Border x:Name="Row" CornerRadius="9" Padding="7,6" Margin="0,1"
                    Loaded="OnRowLoaded" MouseLeftButtonDown="OnRowMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.FieldHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 完成圈 -->
                    <Grid Width="17" Height="17" VerticalAlignment="Top" Margin="0,2,0,0"
                          Cursor="Hand" Background="Transparent" MouseLeftButtonDown="OnToggleDone">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Fg3}" StrokeThickness="1.4" Fill="Transparent" />
                        <Path x:Name="Tick" Data="{StaticResource Ico.Check}" Stroke="{DynamicResource Brush.White}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="9" Height="9" Stretch="Uniform" Opacity="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="9,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="PrioDot" Width="5" Height="5" Margin="0,0,6,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="2">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="3">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="1">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Fg3}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Fg0}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" VerticalAlignment="Center" />
                            <TextBox x:Name="EditBox" Grid.Column="1" Style="{StaticResource FlatTextBox}" Margin="-3,-2,0,-2"
                                     Text="{Binding Title, Mode=TwoWay}"
                                     Visibility="{Binding IsEditing, Converter={StaticResource Vis}}"
                                     KeyDown="OnEditKeyDown" LostFocus="OnEditLostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource Brush.Fg2}"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasMeta, Converter={StaticResource Vis}}" />
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="32">
                        <TextBlock x:Name="TimeText" Text="{Binding TimeText}" FontSize="10.5"
                                   HorizontalAlignment="Right" FontFamily="Segoe UI"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="DelBtn" Style="{StaticResource IconButton}" Width="20" Height="20"
                                HorizontalAlignment="Right" Opacity="0" Click="OnDelete" ToolTip="删除">
                            <Path Data="{StaticResource Ico.Trash}" Stroke="{DynamicResource Brush.Fg2}"
                                  StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="DelBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="TimeText" Property="Opacity" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TitleText" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 归档行 -->
        <DataTemplate x:Key="ArchiveTemplate">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Ico.Check}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"
                      Stretch="Uniform" VerticalAlignment="Center" Opacity="0.85" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Margin="8,0,6,0"
                           Foreground="{DynamicResource Brush.Fg1}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Brush.Fg3}"
                           FontFamily="Segoe UI" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArchiveGroupHeader">
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource Brush.Fg3}"
                       Margin="8,9,0,2" />
        </DataTemplate>

        <!-- 设置行 -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg3}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
      <!-- 外层留白用于投影 -->
      <Grid x:Name="CardHost" Margin="20">
        <!-- 阴影单独一层：只对纯色圆角矩形做模糊，避免整棵视觉树参与离屏渲染 -->
        <Border CornerRadius="18" Background="#FF000000" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#FF000000" />
            </Border.Effect>
        </Border>

        <Border x:Name="Shell" CornerRadius="18" BorderThickness="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= 头部 ================= -->
                <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="18,15,12,6"
                      MouseLeftButtonDown="OnHeaderDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DayNum" Text="22" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Fg0}" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthLine" Text="十月 · 周四" FontSize="11"
                                       Foreground="{DynamicResource Brush.Fg2}" />
                            <TextBlock x:Name="SubLine" Text="今天还有 3 项" FontSize="11.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.Fg1}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnArchive" Style="{StaticResource IconButton}" ToolTip="归档记录" Click="OnOpenArchive">
                            <Path Data="{StaticResource Ico.Archive}" Stroke="{DynamicResource Brush.Fg1}"
                                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="设置" Click="OnOpenSettings">
                            <Path Data="{StaticResource Ico.Settings}" Stroke="{DynamicResource Brush.Fg1}"
                                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnCollapse" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="收起" Click="OnToggleCompact">
                            <Path x:Name="CollapseIcon" Data="{StaticResource Ico.Up}" Stroke="{DynamicResource Brush.Fg1}"
                                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 主体 ================= -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 快速添加 -->
                    <Border x:Name="AddBar" Grid.Row="0" Margin="16,4,16,6" Height="36" CornerRadius="10"
                            Background="{DynamicResource Brush.Field}" BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Line}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Ico.Plus}" Stroke="{DynamicResource Brush.Fg2}"
                                  StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform"
                                  Margin="11,0,8,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AddBox" Style="{StaticResource FlatTextBox}" FontSize="12"
                                         VerticalAlignment="Center" KeyDown="OnAddKeyDown" />
                                <TextBlock x:Name="Placeholder" Text="明天下午3点 评审会 #工作"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Fg3}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=AddBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=AddBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="↵" FontSize="10" Margin="0,0,11,0"
                                       Foreground="{DynamicResource Brush.Fg3}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 任务列表 -->
                    <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="10,0,8,3"
                                  Focusable="False">
                        <ItemsControl x:Name="TaskList" Focusable="False" VerticalAlignment="Top">
                            <ItemsControl.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}">
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="TaskTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"
                                Margin="0,4,0,8">
                        <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.AccentSoft}">
                            <Grid>
                                <Path Data="{StaticResource Ico.LeafFill}" Fill="{DynamicResource Brush.Accent}"
                                      Width="17" Height="17" Stretch="Uniform" Opacity="0.92"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Data="{StaticResource Ico.LeafVein}" Stroke="#FFFFFFFF" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform" Opacity="0.75"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="今天没有待办" FontSize="12" Margin="0,11,0,0"
                                   Foreground="{DynamicResource Brush.Fg1}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyTip" Text="输入一句话即可添加，例如「明天9点 晨跑」"
                                   FontSize="10.5" Margin="0,5,0,0" Foreground="{DynamicResource Brush.Fg3}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ================= 底部进度 ================= -->
                <Grid x:Name="Footer" Grid.Row="2" Margin="18,6,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="3" CornerRadius="2" Background="{DynamicResource Brush.Track}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProgDone" Width="0*" />
                                <ColumnDefinition x:Name="ProgRest" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource Brush.Accent}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Name="FooterText" Text="今天 0/0" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Fg2}" />
                        <TextBlock x:Name="FooterHotkey" Text="Ctrl+Alt+P" FontSize="9.5"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Fg3}" />
                    </Grid>
                </Grid>

                <!-- ================= 覆盖面板 ================= -->
                <Grid x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
                    <Border CornerRadius="17" Background="{DynamicResource Brush.Surface}"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
                      <Grid>

                        <!-- 归档 -->
                        <Grid x:Name="ArchivePanel" Visibility="Collapsed" Margin="16,14,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Click="OnCloseOverlay" ToolTip="返回">
                                        <Path Data="{StaticResource Ico.Back}" Stroke="{DynamicResource Brush.Fg1}"
                                              StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Text="归档" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Brush.Fg0}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="清空" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        Click="OnClearArchive" ToolTip="清空全部归档记录" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="2,14,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ArcTotal" Text="0" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Fg0}" FontFamily="Segoe UI" />
                                    <TextBlock Text="累计完成" FontSize="9.5" Foreground="{DynamicResource Brush.Fg3}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ArcWeek" Text="0" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Fg0}" FontFamily="Segoe UI" />
                                    <TextBlock Text="本周" FontSize="9.5" Foreground="{DynamicResource Brush.Fg3}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="ArcStreak" Text="0" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" FontFamily="Segoe UI" />
                                    <TextBlock Text="连续天数" FontSize="9.5" Foreground="{DynamicResource Brush.Fg3}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Focusable="False">
                                <ItemsControl x:Name="ArcList" Focusable="False" VerticalAlignment="Top">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource ArchiveGroupHeader}">
                                            <GroupStyle.Panel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </GroupStyle.Panel>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="ArchiveTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="ArcEmpty" Grid.Row="2" Text="还没有完成的记录" FontSize="11"
                                       Foreground="{DynamicResource Brush.Fg3}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>

                        <!-- 设置 -->
                        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="16,14,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Click="OnCloseOverlay" ToolTip="返回">
                                    <Path Data="{StaticResource Ico.Back}" Stroke="{DynamicResource Brush.Fg1}"
                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Fg0}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="2,12,4,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="深色主题" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="低光环境下更柔和" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="SwDark" Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Click="OnToggleTheme" />
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="窗口置顶" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="始终浮于其它窗口之上" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="SwTopmost" Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Click="OnToggleTopmost" />
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="桌面层模式" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="失去焦点后沉到桌面，不遮挡工作" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="SwDesktop" Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Click="OnToggleDesktopLayer" />
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="开机自启" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="登录后自动显示在桌面" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <ToggleButton x:Name="SwAutostart" Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Click="OnToggleAutostart" />
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,12" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Agent 投递目录" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="把 .json 放进 inbox 即可自动入列" Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开" Style="{StaticResource GhostButton}"
                                                VerticalAlignment="Center" Click="OnOpenDataDir" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="快捷键" Style="{StaticResource SettingTitle}" />
                                            <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+P 显示 / 隐藏"
                                                       Style="{StaticResource SettingHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="退出程序" Style="{StaticResource GhostButton}"
                                                VerticalAlignment="Center" Click="OnExitApp" />
                                    </Grid>

                                    <TextBlock x:Name="VersionText" Text="Rou 1.0" FontSize="9.5"
                                               Foreground="{DynamicResource Brush.Fg3}" Margin="0,10,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                      </Grid>
                    </Border>
                </Grid>

                <!-- ================= 提示条 ================= -->
                <Border x:Name="ToastBox" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom"
                        HorizontalAlignment="Center" Margin="0,0,0,9" CornerRadius="9"
                        Background="{DynamicResource Brush.ToastBg}" Padding="12,6" Opacity="0"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastShift" Y="6" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastText" Text="" FontSize="11" Foreground="{DynamicResource Brush.ToastFg}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastAction" Text="撤销" FontSize="11" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                   Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="OnToastAction" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
      </Grid>

      <!-- 贴边吸附后的收起态：点击恢复 -->
      <Border x:Name="DockTab" Visibility="Collapsed" CornerRadius="13" Cursor="Hand"
              Background="{DynamicResource Brush.AccentSoft}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              ToolTip="点击展开 Rou" MouseLeftButtonUp="OnUndockClick">
          <TextBlock Text="Qiu" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
</Window>
