<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Brush.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1C221E" Offset="0" />
        <GradientStop Color="#FF151A17" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Field" Color="#FF232A25" />
    <SolidColorBrush x:Key="Brush.FieldHover" Color="#FF2C3530" />
    <SolidColorBrush x:Key="Brush.Line" Color="#FF2E3833" />
    <SolidColorBrush x:Key="Brush.Fg0" Color="#FFF3F5F9" />
    <SolidColorBrush x:Key="Brush.Fg1" Color="#FFA9B0BD" />
    <SolidColorBrush x:Key="Brush.Fg2" Color="#FF79808D" />
    <SolidColorBrush x:Key="Brush.Fg3" Color="#FF5B626E" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5FD08F" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FF1E3328" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFE8A33D" />
    <SolidColorBrush x:Key="Brush.Track" Color="#FF2A322D" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF3D434E" />
    <SolidColorBrush x:Key="Brush.ToastBg" Color="#FFE9EDF5" />
    <SolidColorBrush x:Key="Brush.ToastFg" Color="#FF14161A" />
    <SolidColorBrush x:Key="Brush.White" Color="#FFFFFFFF" />

</ResourceDictionary>
