<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Brush.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDFFFE" Offset="0" />
        <GradientStop Color="#FFF3F9F5" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Field" Color="#FFEFF7F1" />
    <SolidColorBrush x:Key="Brush.FieldHover" Color="#FFE5F1E9" />
    <SolidColorBrush x:Key="Brush.Line" Color="#FFDDEBE1" />
    <SolidColorBrush x:Key="Brush.Fg0" Color="#FF16221A" />
    <SolidColorBrush x:Key="Brush.Fg1" Color="#FF4C5F52" />
    <SolidColorBrush x:Key="Brush.Fg2" Color="#FF7B8E81" />
    <SolidColorBrush x:Key="Brush.Fg3" Color="#FFA7B8AC" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF3F9E70" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FFE1F3E9" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFD2564F" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFC98A2E" />
    <SolidColorBrush x:Key="Brush.Track" Color="#FFE6F0E9" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FFC2D6C8" />
    <SolidColorBrush x:Key="Brush.ToastBg" Color="#FF1E2E24" />
    <SolidColorBrush x:Key="Brush.ToastFg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.White" Color="#FFFFFFFF" />

</ResourceDictionary>
